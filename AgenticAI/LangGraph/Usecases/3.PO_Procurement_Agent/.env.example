# =============================================================================
# .env.example — copy to .env and fill in your values
# DO NOT commit .env to Git
# =============================================================================

# ─── Neon Postgres ───────────────────────────────────────────────────────────
# Same connection string for both, just different default schemas via search_path
BUSINESS_DB_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&options=-csearch_path%3Dbusiness_data
AGENT_DB_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&options=-csearch_path%3Dagent_state

# ─── Google Cloud / Vertex AI ────────────────────────────────────────────────
# Set up ADC first:  gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
LLM_MODEL=gemini-2.5-pro
LLM_TEMPERATURE=0.0

# ─── Langfuse (optional but recommended) ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ─── App configuration ───────────────────────────────────────────────────────
MAX_SELF_CORRECTION_ITERATIONS=1
DEFAULT_REGION=Telangana
DEFAULT_WAREHOUSE=Hyderabad-WH1
LOG_LEVEL=INFO

# ─── Frontend (Vite reads VITE_* prefixed vars) ──────────────────────────────
VITE_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────
# AI_Onboarding_Platform — Environment Variables
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ────────────────────────────────────────────
# Both URLs typically point to the SAME database.
# - BUSINESS_DB_URL: used by SQLAlchemy for app data (business_data schema)
# - AGENT_DB_URL:    used by LangGraph for checkpoints (public schema)
BUSINESS_DB_URL=postgresql://user:password@HOST/dbname?sslmode=require
AGENT_DB_URL=postgresql://user:password@HOST/dbname?sslmode=require

# ── Google Cloud / Vertex AI ────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
LLM_MODEL=gemini-2.5-pro
LLM_TEMPERATURE=0.0

# Run this ONCE on your machine to authenticate:
#   gcloud auth application-default login
# It creates the credentials file the SDK auto-discovers.

# ── Langfuse (optional observability) ───────────────────────────────────
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── MCP server ──────────────────────────────────────────────────────────
# Path to sop-mcp/server.py, relative to project root.
SOP_MCP_SERVER_PATH=mcp-servers/sop-mcp/server.py

# ── Application ─────────────────────────────────────────────────────────
MAX_SELF_CORRECTION_ITERATIONS=1
LOG_LEVEL=INFO
